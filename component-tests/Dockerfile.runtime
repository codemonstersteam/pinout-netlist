# godog-раннер. Запускается ТОЛЬКО в Docker (изоляция), не с хоста.
FROM golang:1.26-alpine
RUN apk add --no-cache bash wget
WORKDIR /tests
COPY component-tests/go.mod ./
COPY component-tests/go.sum* ./
RUN go mod download
COPY component-tests/steps ./steps
COPY component-tests/features ./features
ENV CGO_ENABLED=0
ENTRYPOINT ["go", "test", "-v", "-count=1", "./steps/..."]
